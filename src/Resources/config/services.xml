<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Ruhrcoder\RcCustomerImageGallery\Service\GalleryCustomFieldInstaller" public="true">
            <argument type="service" id="custom_field_set.repository"/>
            <argument type="service" id="custom_field.repository"/>
            <argument type="service" id="logger" on-invalid="null"/>
        </service>

        <service id="Ruhrcoder\RcCustomerImageGallery\Service\GalleryLoader">
            <argument type="service" id="media.repository"/>
        </service>

        <service id="Ruhrcoder\RcCustomerImageGallery\Subscriber\ProductPageSubscriber">
            <argument type="service" id="Ruhrcoder\RcCustomerImageGallery\Service\GalleryLoader"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
